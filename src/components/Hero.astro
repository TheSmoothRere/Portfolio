---

---

<section class="relative min-h-dvh flex items-center overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-40"></div>
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-surface-tint/3 blur-3xl pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 right-0 h-32 bg-linear-to-t from-surface to-transparent pointer-events-none"
  >
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 pt-28 pb-20 w-full">
    <div data-animate="fade-down" data-animate-delay="100" class="mb-6 md:mb-8 flex items-center gap-2 font-mono text-xs tracking-label-caps text-surface-tint">
      <span
        class="w-2 h-2 rounded-full bg-surface-tint shadow-[0_0_8px] shadow-surface-tint/60"
      ></span>
      <span class="text-surface-tint">System ready</span>
      <span class="text-outline mx-2">//</span>
      <span class="text-on-surface-variant">v2.0.1</span>
    </div>

    <div class="relative">
      <div data-animate="fade-up" class="max-w-4xl flex flex-col items-start">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-display-xl font-display font-bold tracking-display text-on-surface leading-[1.1] mb-4 wrap-break-word"
        >
          TheSmoothRere<br class="hidden sm:block" />
          Full-Stack Web<br class="hidden sm:block" />
          <span class="text-surface-tint">Developer</span> &amp;<br
            class="hidden sm:block"
          />
          Minecraft Mod Developer
        </h1>
        <p
          class="text-base sm:text-lg text-on-surface-variant leading-relaxed max-w-xl mb-8 md:mb-10 mt-4 md:mt-6"
        >
          I'm TheSmoothRere, a full-stack web developer and Minecraft mod developer.
          I build web applications with React, Next.js, and Spring Boot, and develop
          Minecraft Fabric mods in Java with 100K+ downloads. I work with TypeScript,
          PostgreSQL, Redis, and Docker to deliver solutions that combine technical
          precision with creativity.
        </p>
      </div>
      <img
        src="/favicon.svg"
        alt="hero-icon"
        data-animate="fade-right"
        data-animate-delay="300"
        class="absolute -top-8 right-0 lg:-right-12 w-40 md:w-52 lg:w-64 opacity-30 hidden lg:block pointer-events-none"
      />
    </div>

    <div data-animate="fade-up" data-animate-delay="300" class="flex flex-wrap items-center gap-4">
      <a
        href="#projects"
        class="text-xs sm:text-sm font-mono tracking-label-caps uppercase px-5 sm:px-6 py-3 btn-outline rounded-none transition-all duration-200 flex items-center gap-2 group"
      >
        View Projects
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        >
          <path d="M7 17l9.2-9.2M17 17V7H7"></path>
        </svg>
      </a>
      <a
        href="#contact"
        class="text-xs sm:text-sm font-mono tracking-label-caps uppercase px-5 sm:px-6 py-3 text-on-surface hover:text-surface-tint transition-colors relative link-underline"
      >
        Get in Touch
      </a>
    </div>
  </div>
</section>
