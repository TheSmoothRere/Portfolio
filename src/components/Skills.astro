---
import SectionLabel from "./SectionLabel.astro";

const skillGroups = [
  {
    category: "Frontend",
    items: ["React", "Next.js", "TypeScript", "Tailwind CSS", "Framer Motion", "Redux"],
  },
  {
    category: "Backend",
    items: ["Node.js", "Python", "Go", "PostgreSQL", "MongoDB", "GraphQL"],
  },
  {
    category: "DevOps",
    items: ["Docker", "Kubernetes", "AWS", "Terraform", "CI/CD", "Linux"],
  },
  {
    category: "Design",
    items: ["Figma", "System Design", "UI/UX", "Prototyping", "Design Tokens", "Accessibility"],
  },
];
---

<section id="skills" class="py-section-y">
  <div class="max-w-6xl mx-auto px-6">
    <SectionLabel number="03" label="Skills" class="mb-8" />

    <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
      {skillGroups.map((group, gi) => (
        <div>
          <div class="flex items-center gap-3 mb-5">
            <span class="w-2 h-2 rounded-full bg-surface-tint shadow-[0_0_8px] shadow-surface-tint/40"></span>
            {gi > 0 && <span class="wire-horizontal flex-1 max-w-12"></span>}
            <h3 class="font-mono text-xs tracking-label-caps uppercase text-on-surface-variant">{group.category}</h3>
          </div>
          <div class="flex flex-wrap gap-2.5 pl-7">
            {group.items.map((skill, si) => (
              <span
                class="relative text-sm font-mono tracking-label-mono px-3.5 py-2 rounded-sm bg-surface-container/50 border border-surface-container-high text-on-surface-variant hover:border-surface-tint/40 hover:text-surface-tint transition-all duration-200"
              >
                {skill}
                {si < group.items.length - 1 && (
                  <span class="absolute -right-3 top-1/2 -translate-y-1/2 w-1 h-px bg-surface-container-highest hidden md:block last:hidden"></span>
                )}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
      {["TypeScript", "React", "Node.js", "Python"].map((lang) => (
        <div class="card-border-glow rounded px-5 py-4 bg-surface-container/30 text-center group cursor-default">
          <div class="text-2xl font-bold font-display text-surface-tint mb-1 group-hover:scale-110 transition-transform">
            {lang === "TypeScript" ? "95" : lang === "React" ? "92" : lang === "Node.js" ? "88" : "85"}%
          </div>
          <div class="text-xs font-mono tracking-label-mono text-on-surface-variant">{lang}</div>
          <div class="mt-2 h-1 rounded-full bg-surface-container-high overflow-hidden">
            <div
              class="h-full rounded-full bg-surface-tint/60 transition-all duration-500"
              style={{ width: lang === "TypeScript" ? "95%" : lang === "React" ? "92%" : lang === "Node.js" ? "88%" : "85%" }}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
