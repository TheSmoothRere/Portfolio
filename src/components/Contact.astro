---
import SectionLabel from "./SectionLabel.astro";
---

<section id="contact" class="py-section-y">
  <div class="max-w-6xl mx-auto px-6">
    <SectionLabel number="05" label="Contact" class="mb-8" />

    <div class="grid md:grid-cols-2 gap-16 overflow-x-hidden">
      <div>
        <h3 class="text-display-lg font-display font-bold tracking-display text-on-surface leading-[1.1] mb-6">
          Let's build<br />
          <span class="text-surface-tint">something</span> together
        </h3>
        <p class="text-on-surface-variant leading-relaxed mb-8 max-w-md">
          I'm currently open to freelance projects and full-time opportunities.
          Whether you have a question or just want to say hi, I'll get back to you.
        </p>

        <div class="flex flex-col gap-4">
          <a href="mailto:thesmoothrere@gmail.com" class="grid grid-cols-[auto_1fr] gap-3 text-on-surface-variant hover:text-surface-tint transition-colors group">
            <span class="w-10 h-10 rounded-sm border border-surface-container-highest flex items-center justify-center group-hover:border-surface-tint/40 transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="M22 4l-10 8L2 4"/>
              </svg>
            </span>
            <span class="font-mono text-sm tracking-label-mono truncate self-center text-left">[EMAIL_ADDRESS]</span>
          </a>

          <a href="https://github.com/TheSmoothRere" class="grid grid-cols-[auto_1fr] gap-3 text-on-surface-variant hover:text-surface-tint transition-colors group">
            <span class="w-10 h-10 rounded-sm border border-surface-container-highest flex items-center justify-center group-hover:border-surface-tint/40 transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
            </span>
            <span class="font-mono text-sm tracking-label-mono truncate self-center text-left">[GITHUB]</span>
          </a>

          <a href="https://linkedin.com/in/raehan-damai-putra" class="grid grid-cols-[auto_1fr] gap-3 text-on-surface-variant hover:text-surface-tint transition-colors group">
            <span class="w-10 h-10 rounded-sm border border-surface-container-highest flex items-center justify-center group-hover:border-surface-tint/40 transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                <rect x="2" y="9" width="4" height="12"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </span>
            <span class="font-mono text-sm tracking-label-mono truncate self-center text-left">[LINKEDIN]</span>
          </a>
        </div>
      </div>

      <div class="card-border-glow rounded p-8 bg-surface-container/20">
        <form id="contact-form" class="flex flex-col gap-5">
          <div>
            <label for="name" class="block text-xs font-mono tracking-label-caps uppercase text-on-surface-variant mb-2">Name</label>
            <input id="name" name="name" type="text" class="w-full bg-surface border-b-2 border-surface-container-high px-3 py-2.5 text-sm text-on-surface outline-none focus:border-surface-tint transition-colors duration-300 font-body" placeholder="Your name" required />
          </div>
          <div>
            <label for="email" class="block text-xs font-mono tracking-label-caps uppercase text-on-surface-variant mb-2">Email</label>
            <input id="email" name="email" type="email" class="w-full bg-surface border-b-2 border-surface-container-high px-3 py-2.5 text-sm text-on-surface outline-none focus:border-surface-tint transition-colors duration-300 font-body" placeholder="your@email.com" required />
          </div>
          <div>
            <label for="message" class="block text-xs font-mono tracking-label-caps uppercase text-on-surface-variant mb-2">Message</label>
            <textarea id="message" name="message" rows="4" class="w-full bg-surface border-b-2 border-surface-container-high px-3 py-2.5 text-sm text-on-surface outline-none focus:border-surface-tint transition-colors duration-300 font-body resize-none" placeholder="Tell me about your project..." required></textarea>
          </div>
          <button type="submit" class="self-start text-sm font-mono tracking-label-caps uppercase px-6 py-3 btn-outline rounded-none transition-all duration-200">
            Send Message
          </button>
        </form>
        <script>
          document.getElementById("contact-form")?.addEventListener("submit", (e) => {
            e.preventDefault();
            const name = (document.getElementById("name") as HTMLInputElement)?.value?.trim();
            const email = (document.getElementById("email") as HTMLInputElement)?.value?.trim();
            const message = (document.getElementById("message") as HTMLInputElement)?.value?.trim();
            if (!name || !email || !message) return;
            const subject = encodeURIComponent(`New inquiry from ${name}`);
            const body = encodeURIComponent(
              `Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`
            );
            window.location.href = `mailto:thesmoothrere@gmail.com?subject=${subject}&body=${body}`;
          });
        </script>
      </div>
    </div>
  </div>
</section>
