---
const { number, label } = Astro.props;
---

<div class="flex items-center gap-3 font-mono tracking-label-caps text-xs uppercase mb-4">
  <span class="text-surface-tint font-medium">{number}.</span>
  <span class="text-on-surface-variant">{label}</span>
  <span class="h-px flex-1 bg-surface-container-high max-w-20"></span>
</div>
