---
import "@/styles/global.css";
import Layout from "@/layouts/Layout.astro";
import CvContent from "@/components/CvContent";
---

<Layout
  title="CV — Raehan Damai Putra | Full-Stack Developer & Open Source Contributor"
  description="Professional CV of Raehan Damai Putra — Full-Stack Developer & Open Source Contributor"
  image="/favicon.svg"
  path="/cv"
>
  <CvContent client:load />
</Layout>

<style is:global>
  @media print {
    @page {
      margin: 0;
    }

    body {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    nav, #nav, .fixed, header:has(nav) {
      display: none !important;
    }
  }
</style>
