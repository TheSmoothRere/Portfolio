---
import "@/styles/global.css";
import Layout from "@/layouts/Layout.astro";
import { HugeiconsIcon } from "@hugeicons/react";
import { PrinterIcon } from "@hugeicons/core-free-icons";

const name = "Raehan Damai Putra";
const title = "Cover Letter";

const today = new Date();
const formattedDateID = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(today);

const formattedDateEN = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(today);
---

<Layout
  title={`${title} — ${name}`}
  description={`Professional ${title} of ${name}`}
  image="/favicon.svg"
  path="/cover-letter"
>
  <main id="main-content" class="min-h-screen bg-slate-100 py-10 px-4">
    <div
      class="max-w-4xl mx-auto bg-white shadow-xl rounded-sm overflow-hidden min-h-[297mm] p-8"
    >
      <div id="cover-content" data-lang="id">
        <div class="px-16 py-20 space-y-8">
          <div class="flex justify-between">
            <div class="text-slate-800 font-medium text-sm">
              <p>Kepada Yth.</p>
              <p>Bapak/Ibu HRD / Pimpinan Perusahaan</p>
              <p>Di Tempat</p>
            </div>
            <div class="text-right text-slate-600 text-sm mb-8">
              Cirebon, {formattedDateID}
            </div>
          </div>

          <div
            class="text-slate-700 leading-relaxed text-sm space-y-5 text-justify"
          >
            <p>Dengan hormat,</p>

            <p>
              Melalui surat ini, saya bermaksud untuk mengajukan diri guna
              bergabung dan berkontribusi di perusahaan yang Bapak/Ibu pimpin.
              Saya memiliki ketertarikan yang besar untuk membawa nilai tambah
              serta berkembang bersama tim profesional di perusahaan Bapak/Ibu.
            </p>

            <p>
              Saya adalah pribadi yang berorientasi pada hasil dengan kombinasi
              kemampuan teknis, analitis, dan manajerial yang solid. Saya memiliki
              rekam jejak dalam mengelola tanggung jawab secara mandiri maupun
              kolaboratif yang telah memberikan dampak nyata. Pengalaman saya
              dalam menghadapi tantangan kompleks, melakukan analisis masalah,
              serta mencari solusi yang efisien telah membentuk saya menjadi
              individu yang disiplin, detail, dan berkomitmen tinggi terhadap
              kualitas hasil kerja.
            </p>

            <p>
              Selain itu, saya memiliki kemampuan adaptasi yang tinggi terhadap
              lingkungan baru dan cepat dalam menguasai sistem maupun prosedur
              kerja yang diterapkan perusahaan. Saya juga fasih berkomunikasi
              dalam bahasa Indonesia dan Inggris tingkat profesional, yang
              memungkinkan saya untuk berinteraksi secara efektif dengan berbagai
              pihak di berbagai level organisasi.
            </p>

            <div class="space-y-4">
              <p>
                Sebagai bahan pertimbangan Bapak/Ibu, berikut adalah kualifikasi
                utama yang saya miliki:
              </p>
              <ul class="list-decimal pl-5 space-y-2">
                <li>
                  <strong>Orientasi pada Hasil & Kualitas:</strong> Terbiasa bekerja
                  dengan target dan memastikan setiap tanggung jawab diselesaikan dengan
                  standar kualitas terbaik.
                </li>
                <li>
                  <strong>Kemampuan Analitis & Problem Solving:</strong> Mampu menganalisis
                  situasi kompleks untuk menemukan solusi yang paling efektif dan efisien.
                </li>
                <li>
                  <strong>Adaptabilitas & Pembelajaran Cepat:</strong> Kemampuan belajar
                  yang tinggi terhadap teknologi, perangkat lunak, maupun alur kerja
                  baru guna mendukung efektivitas operasional.
                </li>
                <li>
                  <strong>Komunikasi & Kolaborasi:</strong> Mampu bekerja sama dalam
                  tim maupun secara mandiri dengan koordinasi yang baik untuk mencapai
                  tujuan bersama.
                </li>
              </ul>
            </div>

            <p>
              Bersama surat ini, saya lampirkan Daftar Riwayat Hidup (CV) serta
              dokumen pendukung lainnya yang memberikan gambaran lebih mendalam
              mengenai kualifikasi dan potensi yang saya miliki.
            </p>

            <p>
              Besar harapan saya untuk diberikan kesempatan menghadiri sesi
              wawancara, agar saya dapat menjelaskan lebih lanjut mengenai
              bagaimana latar belakang dan kemampuan saya dapat memberikan
              kontribusi nyata bagi kemajuan perusahaan Bapak/Ibu.
            </p>

            <p>
              Demikian surat lamaran ini saya sampaikan. Atas perhatian dan
              kesempatan yang Bapak/Ibu berikan, saya ucapkan terima kasih.
            </p>
          </div>

          <div class="pt-12 flex justify-between items-center">
            <span></span>
            <div class="text-center text-slate-800 text-sm flex flex-col gap-16">
              <p>Hormat saya,</p>
              <p class="font-bold">{name}</p>
            </div>
          </div>
        </div>
      </div>

      <div id="cover-content" data-lang="en" hidden>
        <div class="px-16 py-20 space-y-8">
          <div class="flex justify-between">
            <div class="text-slate-800 font-medium text-sm">
              <p>To whom it may concern,</p>
              <p>HRD Manager / Company Director</p>
            </div>
            <div class="text-right text-slate-600 text-sm mb-8">
              Cirebon, {formattedDateEN}
            </div>
          </div>

          <div
            class="text-slate-700 leading-relaxed text-sm space-y-5 text-justify"
          >
            <p>Dear Sir/Madam,</p>

            <p>
              Through this letter, I intend to submit my application to join
              and contribute to the company you lead. I have a strong interest
              in bringing added value and growing together with the professional
              team at your company.
            </p>

            <p>
              I am a results-oriented individual with a solid combination of
              technical, analytical, and managerial skills. I have a proven
              track record of managing responsibilities both independently and
              collaboratively, delivering tangible impact. My experience in
              handling complex challenges, conducting problem analysis, and
              finding efficient solutions has shaped me into a disciplined,
              detail-oriented person with a high commitment to quality output.
            </p>

            <p>
              Furthermore, I have a high adaptability to new environments and
              can quickly master systems and work procedures implemented by
              the company. I am fluent in both Indonesian and English at a
              professional level, enabling me to communicate effectively with
              various parties across different organizational levels.
            </p>

            <div class="space-y-4">
              <p>
                For your consideration, here are my key qualifications:
              </p>
              <ul class="list-decimal pl-5 space-y-2">
                <li>
                  <strong>Results & Quality Orientation:</strong> Accustomed to working
                  with targets and ensuring every responsibility is completed to the
                  highest quality standards.
                </li>
                <li>
                  <strong>Analytical & Problem-Solving Skills:</strong> Able to analyze
                  complex situations to find the most effective and efficient solutions.
                </li>
                <li>
                  <strong>Adaptability & Fast Learning:</strong> High learning ability
                  for new technologies, software, and workflows to support operational
                  effectiveness.
                </li>
                <li>
                  <strong>Communication & Collaboration:</strong> Able to work in teams
                  as well as independently with good coordination to achieve shared goals.
                </li>
              </ul>
            </div>

            <p>
              Along with this letter, I have enclosed my Curriculum Vitae (CV)
              and other supporting documents that provide a deeper overview of
              my qualifications and potential.
            </p>

            <p>
              I sincerely hope to be given the opportunity to attend an
              interview, where I can further explain how my background and
              abilities can make a real contribution to the advancement of
              your company.
            </p>

            <p>
              Thus I submit this application letter. Thank you for your
              attention and the opportunity you provide.
            </p>
          </div>

          <div class="pt-12 flex justify-between items-center">
            <span></span>
            <div class="text-center text-slate-800 text-sm flex flex-col gap-16">
              <p>Sincerely,</p>
              <p class="font-bold">{name}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-center gap-4 print:hidden">
      <button
        id="lang-toggle"
        class="flex items-center justify-center gap-2 bg-white hover:bg-slate-100 text-slate-800 text-sm font-bold py-3 px-6 rounded-full transition-all shadow-lg active:scale-95 cursor-pointer border border-slate-300"
      >
        <span id="lang-label">EN</span>
      </button>
      <button
        id="print-letter"
        class="flex items-center justify-center gap-2 bg-slate-800 hover:bg-black text-white text-sm font-bold py-3 px-8 rounded-full transition-all shadow-2xl active:scale-95 cursor-pointer"
      >
        <HugeiconsIcon icon={PrinterIcon} size={20} />
        Print / PDF
      </button>
    </div>
  </main>
</Layout>

<script>
  const LANG_KEY = "cover-letter-lang";

  function getPreferredLang() {
    return localStorage.getItem(LANG_KEY) || "id";
  }

  function setLang(lang) {
    localStorage.setItem(LANG_KEY, lang);
    document.querySelectorAll("#cover-content").forEach((el) => {
      el.hidden = el.dataset.lang !== lang;
    });
    document.getElementById("lang-label").textContent = lang === "id" ? "EN" : "ID";
  }

  document.getElementById("lang-toggle")?.addEventListener("click", () => {
    const current = getPreferredLang();
    setLang(current === "id" ? "en" : "id");
  });

  document
    .getElementById("print-letter")
    ?.addEventListener("click", () => window.print());

  setLang(getPreferredLang());
</script>

<style is:global>
  @media print {
    @page {
      margin: 0;
    }
    body {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      background: white !important;
    }
    nav,
    #nav,
    header:has(nav),
    footer,
    #menu-toggle,
    #mobile-menu,
    .fixed {
      display: none !important;
    }
    #main-content {
      padding: 0 !important;
      background: white !important;
      min-height: auto !important;
    }
    #main-content > div {
      box-shadow: none !important;
      border-radius: 0 !important;
      max-width: 100% !important;
    }
    #print-letter {
      display: none !important;
    }
  }
</style>
